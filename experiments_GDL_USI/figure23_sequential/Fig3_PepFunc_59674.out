  task: graph
  task_type: classification_multilabel
  to_undirected: False
  transductive: False
  transform: none
  tu_simple: True
device: cuda:0
dynamic:
  additions_factor: 0.1
  aggregation: sum
  minimum_additions: 1
  num_iterations: 20
  num_snapshots: 3
  pre_transform: laserglobal
  rewiring_level: orbit
  rewiring_method: adjacency
  shuffle: True
  sparsification_thresh: 0.001
  teleport_proba: 0.05
example_arg: example
example_group:
  example_arg: example
gnn:
  act: relu
  agg: mean
  att_final_linear: False
  att_final_linear_bn: False
  att_heads: 1
  batchnorm: True
  clear_feature: True
  dim_inner: 250
  dropout: 0.0
