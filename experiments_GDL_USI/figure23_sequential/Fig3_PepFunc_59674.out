  keep_edge: 0.5
  l2norm: True
  layer_type: gcnconv
  layers_mp: 5
  layers_post_mp: 1
  layers_pre_mp: 0
  msg_direction: single
  normalize_adj: False
  residual: False
  self_msg: concat
  skip_every: 1
  stage_type: stack
gpu_mem: False
gt:
  attn_dropout: 0.0
  batch_norm: True
