benchmark: False
bn:
  eps: 1e-05
  mom: 0.1
cfg_dest: config.yaml
dataset:
  cache_load: False
  cache_save: False
  dir: ./datasets
  edge_dim: 128
  edge_encoder: False
  edge_encoder_bn: True
