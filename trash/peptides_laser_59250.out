        (3): Embedding(12, 250)
        (4): Embedding(10, 250)
        (5): Embedding(6, 250)
        (6): Embedding(6, 250)
        (7): Embedding(2, 250)
        (8): Embedding(2, 250)
      )
    )
  )
  (mp): DynamicGNNStackStage(
    (layer0): DynamicGeneralLayer(
      (layers): ModuleList(
        (0): GCNConv(
          (model): GCNConv(250, 250)
        )
      )
      (post_layer): Sequential(
