          (model): GCNConv(250, 250)
        )
      )
      (post_layer): Sequential(
        (0): BatchNorm1d(250, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
        (1): ReLU()
      )
    )
    (layer3): DynamicGeneralLayer(
      (layers): ModuleList(
        (0): GCNConv(
          (model): GCNConv(250, 250)
        )
      )
      (post_layer): Sequential(
        (0): BatchNorm1d(250, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
        (1): ReLU()
      )
    )
    (layer4): DynamicGeneralLayer(
      (layers): ModuleList(
        (0): GCNConv(
          (model): GCNConv(250, 250)
        )
        (1): GCNConv(
          (model): GCNConv(250, 250)
        )
        (2): GCNConv(
          (model): GCNConv(250, 250)
        )
      )
      (post_layer): Sequential(
        (0): BatchNorm1d(250, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
        (1): ReLU()
      )
    )
  )
  (post_mp): GNNGraphHead(
    (layer_post_mp): MLP(
      (model): Sequential(
        (0): Linear(
          (model): Linear(in_features=250, out_features=11, bias=True)
        )
      )
    )
  )
)
